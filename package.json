{
  "name": "mypets",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "node scripts/serve-static.mjs",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "postbuild": "node scripts/prepare-pwa.mjs",
    "brand:icons": "node scripts/brand-icons.mjs",
    "assets:check": "node scripts/validate-3d-assets.mjs public/models && node --test scripts/validate-3d-assets.selfcheck.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/fraunces": "5.3.0",
    "@huggingface/transformers": "4.3.2",
    "@mlc-ai/web-llm": "0.2.87",
    "@phosphor-icons/react": "2.1.10",
    "@react-three/fiber": "9.8.2",
    "@vercel/analytics": "^2.0.1",
    "motion": "14.10.1",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
